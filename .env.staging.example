# Template only — never committed with real values. The deploy workflow
# writes the actual .env.staging file on the VPS from this repo's GitHub
# "staging" Environment (Settings > Environments > staging).
#
# Compose reads this file twice: as --env-file (interpolates ${VAR} in
# docker-compose.yml) and as the backend service's env_file (injected into
# the Django container's environment).

# Interpolated into docker-compose.yml
IMAGE_TAG=
DEPLOY_ENV=staging
DEPLOY_NETWORK=ruby-staging

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ruby-pos.tailXXXX.ts.net
CORS_ALLOWED_ORIGINS=https://ruby-pos.tailXXXX.ts.net:8443

# Database — DB_HOST is the Postgres *service name* (Docker-internal DNS),
# and DB_PORT is Postgres's internal port; neither is the host-published
# port used by local dev (5433).
DB_NAME=ruby_pos_staging
DB_USER=ruby_pos
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
